<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hands-On 6, Task 2: Windows Forms chat client using Kafka.
    NOTE: net8.0-windows + UseWindowsForms only builds on Windows — this
    project cannot be built or run in a Linux sandbox/CI container. Open and
    run it from Visual Studio on Windows.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KafkaChatWinForms</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.6.1" />
  </ItemGroup>

</Project>
